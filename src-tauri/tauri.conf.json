{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ossian-manager",
  "version": "0.1.0",
  "identifier": "com.orest.ossian-manager",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/ossian-manager/browser"
  },
  "app": {
    "windows": [
      {
        "title": "ossian-manager",
        "width": 800,
        "height": 600,
        "transparent": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../src/assets/logo.png",
      "../src/assets/logo.png",
      "../src/assets/logo.png",
      "../src/assets/logo.icns",
      "../src/assets/logo.ico"
    ]
  }
}