{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ossian-manager",
  "version": "0.1.0",
  "identifier": "com.orest.ossian-manager",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist/ossian-manager/browser"
  },
  "app": {
    "windows": [
      {
        "label": "launcher",
        "title": "ossian-manager",
        "width": 1200,
        "height": 800,
        "transparent": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}